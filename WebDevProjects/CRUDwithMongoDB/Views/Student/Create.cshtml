@model MongoCrudApp.Models.Student
@{
    ViewData["Title"] = "Create";
}



<h2>Add Student</h2>

<form asp-action="Create" method="post">
    <input asp-for="Name" class="form-control" placeholder="Name" /><br />
    <input asp-for="Email" class="form-control" placeholder="Email" /><br />
    <input asp-for="Age" class="form-control" placeholder="Age" /><br />
    <button type="submit" class="btn btn-primary">Save</button>
</form>