@{
    ViewData["Title"] = "Home Page";
}

<section class="hero-section animate-in">
    <h1 class="hero-title">Find Your Perfect<br/>Flight ✈️</h1>
    <p class="hero-subtitle">
        Search hundreds of flights and hotel packages to find the best deals for your next adventure.
    </p>
    <a asp-controller="Flight" asp-action="Index" class="hero-cta" id="hero-search-btn">
        🔍 Start Searching
    </a>
</section>

<div class="features-grid">
    <div class="feature-card animate-in animate-in-delay-1">
        <span class="feature-icon">🛫</span>
        <div class="feature-title">Domestic Flights</div>
        <p class="feature-desc">Compare top airlines across major Indian cities with competitive pricing.</p>
    </div>
    <div class="feature-card animate-in animate-in-delay-2">
        <span class="feature-icon">🌍</span>
        <div class="feature-title">International Routes</div>
        <p class="feature-desc">Fly to Dubai, Singapore, London and more with premium carriers.</p>
    </div>
    <div class="feature-card animate-in animate-in-delay-3">
        <span class="feature-icon">🏨</span>
        <div class="feature-title">Flight + Hotel Packages</div>
        <p class="feature-desc">Bundle your flight with luxury hotel stays and save on total trip cost.</p>
    </div>
</div>