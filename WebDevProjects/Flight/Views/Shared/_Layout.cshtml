<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Search and compare flights with optional hotel packages. Find the best deals on domestic and international flights." />
    <title>@ViewData["Title"] - SkySearch</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar-custom">
        <div class="main-container" style="display:flex; align-items:center; justify-content:space-between; padding-top:0; padding-bottom:0; min-height:auto;">
            <a asp-controller="Home" asp-action="Index" class="navbar-brand-custom">
                <span class="navbar-brand-icon">✈️</span>
                SkySearch
            </a>
            <ul class="nav-links">
                <li>
                    <a asp-controller="Home" asp-action="Index" class="nav-link-custom" id="nav-home">
                        🏠 Home
                    </a>
                </li>
                <li>
                    <a asp-controller="Flight" asp-action="Index" class="nav-link-custom" id="nav-search">
                        🔍 Search
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="main-container">
        <main role="main">
            @RenderBody()
        </main>

        <footer class="footer-custom">
            &copy; @DateTime.Now.Year SkySearch &mdash; Find your perfect flight.
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>