
@{
    ViewData["Title"] = "StudentData";
    var data = ViewBag.data;
}

<h1>StudentData</h1>
<table>
<tr>
    <th>Id</th>
	<th>Name</th>
    <th>Age</th>
</tr>
@foreach(var item in data)
{
	
    <tr>
        <td>@item.Id</td>
        <td>@item.Name</td>
        <td>@item.Age</td>
    </tr>
}
</table>
